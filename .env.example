# Private deployment configuration. Never commit a filled .env file.
MAARKSHO_DB_DRIVER=mysql
MAARKSHO_DB_HOST=localhost
MAARKSHO_DB_NAME=
MAARKSHO_DB_USER=
MAARKSHO_DB_PASS=
MAARKSHO_DB_ALLOW_FALLBACK=0
# Only set when explicitly choosing SQLite, using an absolute private path:
# MAARKSHO_SQLITE_PATH=/private/path/maarksho.sqlite
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
